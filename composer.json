{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "devopstem/sp-backend-web",
    "type": "project",
    "description": "Smart Planogram Control Center — multi-tenant planogram management (Laravel + Inertia/React).",
    "keywords": ["planogram", "laravel", "inertia", "firebase", "retail"],
    "license": "MIT",
    "authors": [
        {
            "name": "DevOpsTem",
            "email": "devopstem@gmail.com",
            "homepage": "https://github.com/devopstem-debug"
        }
    ],
    "require": {
        "php": "^8.4",
        "bacon/bacon-qr-code": "^3.1",
        "barryvdh/laravel-dompdf": "^3.1",
        "inertiajs/inertia-laravel": "^2.0",
        "kreait/firebase-php": "^8.6",
        "laravel/framework": "^13.37",
        "laravel/reverb": "^1.12",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "pragmarx/google2fa": "^9.1",
        "predis/predis": "^3.7",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-permission": "^8.3",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.4",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "nunomaduro/collision": "^8.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "php8.4 artisan dev"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php8.4 artisan serve"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
