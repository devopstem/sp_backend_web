APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): true | Local HTTP: false
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SECURE_HEADERS_HSTS=false
# Extra CSP origins for production (comma-separated, optional)
# CSP_CONNECT_SRC_EXTRA=
# CSP_IMG_SRC_EXTRA=
# Vite CSP origins (only for APP_ENV=local|development|dev)
CSP_VITE_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Realtime Database (optional). Prefer Настройки → Интеграции in production.
# FIREBASE_CREDENTIALS must be an absolute path on the server — never commit the JSON.
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=

# Open Food Facts (product bot / barcode lookup). Free, no API key.
# OFF_HOSTS=https://ru.openfoodfacts.org,https://world.openfoodfacts.org
# OFF_CACHE_TTL=86400
# OFF_MISS_CACHE_TTL=3600
# OFF_MIN_INTERVAL_MS=250
# OFF_TIMEOUT=8
# OFF_USER_AGENT="SmartPlanogramControlCenter/2.4 (product-bot; contact=you@example.com)"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Production (браузер через Nginx → wss://domain/app):
# REVERB_HOST=your-domain.tld
# REVERB_PORT=443
# REVERB_SCHEME=https
# PHP → Reverb напрямую (обязательно на VPS, иначе POST /apps/... → 404):
# REVERB_INTERNAL_HOST=127.0.0.1
# REVERB_INTERNAL_PORT=8080
# REVERB_INTERNAL_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
